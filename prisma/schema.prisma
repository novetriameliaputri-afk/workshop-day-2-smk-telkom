generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Model User (Data pengguna lab dengan 3 role: ADMIN, TOOLMAN, PEMINJAM)
model User {
  id                Int           @id @default(autoincrement())
  username          String        @unique
  password          String
  nama              String
  role              String        // ADMIN, TOOLMAN, PEMINJAM
  nisn              String?       // NISN untuk Siswa atau NIP untuk Guru/Staff
  telepon           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relasi
  borrowings        Borrowing[]   @relation("BorrowerUser")
  handledBorrowings Borrowing[]   @relation("ToolmanUser")
  activityLogs      ActivityLog[]
}

// 2. Model Category (Kategori alat lab: Jaringan, Elektronika, Proyektor, Perkakas Lab)
model Category {
  id           Int      @id @default(autoincrement())
  namaKategori String   @unique // Contoh: Jaringan, Elektronika, Proyektor
  createdAt    DateTime @default(now())

  // Relasi
  tools        Tool[]
}

// 3. Model Tool (Inventaris sarana alat lab praktikum)
model Tool {
  id          Int         @id @default(autoincrement())
  namaAlat    String
  spesifikasi String?
  stok        Int         @default(0)
  kondisi     String      @default("BAIK") // BAIK / RUSAK
  categoryId  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relasi
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  borrowings  Borrowing[]
}

// 4. Model Borrowing (Transaksi peminjaman alat praktikum)
model Borrowing {
  id                Int       @id @default(autoincrement())
  userId            Int
  toolId            Int
  jumlah            Int       @default(1)
  tglPinjam         DateTime  @default(now())
  tglKembaliRencana DateTime
  tglKembaliReal    DateTime?
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED
  kondisiKembali    String?   // BAIK, RUSAK, HILANG
  denda             Int       @default(0)
  toolmanId         Int?
  catatan           String?   // Keperluan praktikum / catatan inspeksi fisik
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relasi
  user              User      @relation("BorrowerUser", fields: [userId], references: [id], onDelete: Cascade)
  tool              Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolman           User?     @relation("ToolmanUser", fields: [toolmanId], references: [id])
}

// 5. Model ActivityLog (Rekam jejak sirkulasi sarpras laboratorium)
model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  aksi       String   // LOGIN, LOGOUT, TAMBAH_ALAT, UPDATE_ALAT, AJUKAN_PINJAM, APPROVAL_PINJAM, TOLAK_PINJAM, PENGEMBALIAN_ALAT, etc.
  keterangan String
  createdAt  DateTime @default(now())

  // Relasi
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
