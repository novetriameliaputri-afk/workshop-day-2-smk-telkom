<%- include('../partials/header') %>

<div class="space-y-6">

  <!-- Header Section -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-bold text-slate-900">Audit Log Aktifitas Laboratorium</h1>
        <span class="px-2 py-0.5 text-xs font-bold rounded-full bg-purple-100 text-purple-700">Khusus Admin</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Rekam jejak setiap aksi login, penambahan inventaris, approval sirkulasi, pengembalian alat dan penetapan denda</p>
    </div>
  </div>

  <!-- Filters & Search Bar -->
  <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
    <form action="/activity-logs" method="GET" class="flex flex-col sm:flex-row items-center gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 w-full">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <i class="fa-solid fa-magnifying-glass text-xs"></i>
        </span>
        <input type="text" name="q" value="<%= filters.q %>" placeholder="Cari keterangan, nama user, atau username..." class="w-full pl-9 pr-4 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
      </div>

      <!-- Action Type Filter -->
      <div class="w-full sm:w-56">
        <select name="aksi" class="w-full py-2 px-3 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="ALL">Semua Jenis Aksi</option>
          <% actionsList.forEach(action => { %>
            <option value="<%= action %>" <%= filters.aksi === action ? 'selected' : '' %>><%= action %></option>
          <% }) %>
        </select>
      </div>

      <button type="submit" class="w-full sm:w-auto px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-semibold transition-colors">
        Filter
      </button>

      <% if (filters.q || (filters.aksi && filters.aksi !== 'ALL')) { %>
        <a href="/activity-logs" class="w-full sm:w-auto px-3 py-2 text-center text-xs text-slate-500 hover:text-slate-800 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors">
          Reset
        </a>
      <% } %>
    </form>
  </div>

  <!-- Activity Logs Table -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 font-semibold uppercase tracking-wider">
            <th class="py-3 px-4">Waktu Kejadian</th>
            <th class="py-3 px-4">Pengguna (Aktor)</th>
            <th class="py-3 px-4">Jenis Aksi</th>
            <th class="py-3 px-4">Keterangan Detail Aktifitas</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (logs && logs.length > 0) { %>
            <% logs.forEach(log => { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                
                <!-- Timestamp -->
                <td class="py-3.5 px-4 whitespace-nowrap text-slate-500 font-mono text-[11px]">
                  <i class="fa-regular fa-clock mr-1 text-slate-400"></i>
                  <%= formatDateTime(log.createdAt) %>
                </td>

                <!-- User -->
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <% if (log.user) { %>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-slate-800"><%= log.user.nama %></span>
                      <span class="text-[9px] px-1.5 py-0.2 rounded font-bold uppercase <%= log.user.role === 'ADMIN' ? 'bg-purple-100 text-purple-700' : (log.user.role === 'TOOLMAN' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700') %>">
                        <%= log.user.role %>
                      </span>
                    </div>
                  <% } else { %>
                    <span class="text-slate-400 italic">System Auto</span>
                  <% } %>
                </td>

                <!-- Aksi Badge -->
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <% 
                    let badgeColor = 'bg-slate-100 text-slate-700';
                    if (log.aksi.includes('LOGIN')) badgeColor = 'bg-blue-100 text-blue-700';
                    else if (log.aksi.includes('LOGOUT')) badgeColor = 'bg-slate-100 text-slate-600';
                    else if (log.aksi.includes('APPROVAL')) badgeColor = 'bg-emerald-100 text-emerald-700';
                    else if (log.aksi.includes('TOLAK') || log.aksi.includes('HAPUS')) badgeColor = 'bg-rose-100 text-rose-700';
                    else if (log.aksi.includes('AJUKAN')) badgeColor = 'bg-amber-100 text-amber-800';
                    else if (log.aksi.includes('PENGEMBALIAN')) badgeColor = 'bg-indigo-100 text-indigo-700';
                    else if (log.aksi.includes('TAMBAH')) badgeColor = 'bg-teal-100 text-teal-700';
                  %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase <%= badgeColor %>">
                    <%= log.aksi %>
                  </span>
                </td>

                <!-- Keterangan -->
                <td class="py-3.5 px-4 text-slate-700 leading-relaxed max-w-xl">
                  <%= log.keterangan %>
                </td>

              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="py-10 text-center text-slate-400">
                <i class="fa-solid fa-clock-rotate-left text-3xl mb-2 block text-slate-300"></i>
                Tidak ada data log yang sesuai.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
