<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto space-y-6">

  <!-- Header -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-slate-900">Pemeriksaan Fisik Pengembalian Alat</h1>
      <p class="text-xs text-slate-500 mt-1">Meja Kerja Toolman: Inspeksi kondisi fisik alat praktikum dan penetapan denda</p>
    </div>
    <a href="/borrowings" class="px-3.5 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
      <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
    </a>
  </div>

  <!-- Loan Summary Card -->
  <div class="bg-gradient-to-br from-slate-900 to-indigo-950 rounded-2xl p-6 text-white shadow-md space-y-4">
    <div class="flex items-start justify-between">
      <div>
        <span class="text-[10px] font-bold tracking-wider uppercase text-indigo-300">DATA PEMINJAMAN SARPRAS</span>
        <h2 class="text-lg font-bold mt-0.5"><%= borrowing.tool.namaAlat %></h2>
        <p class="text-xs text-slate-300"><%= borrowing.tool.category.namaKategori %> • Jumlah: <strong class="text-white"><%= borrowing.jumlah %> Unit</strong></p>
      </div>
      <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 font-mono">
        #TRX-<%= String(borrowing.id).padStart(4, '0') %>
      </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-3 border-t border-white/10 text-xs">
      <div>
        <span class="text-slate-400 block text-[10px]">Peminjam:</span>
        <strong class="text-white"><%= borrowing.user.nama %></strong>
        <p class="text-[10px] text-slate-300 font-mono"><%= borrowing.user.nisn ? 'NISN: ' + borrowing.user.nisn : borrowing.user.role %></p>
      </div>
      <div>
        <span class="text-slate-400 block text-[10px]">Tgl Pinjam:</span>
        <strong class="text-white"><%= formatDate(borrowing.tglPinjam) %></strong>
      </div>
      <div>
        <span class="text-slate-400 block text-[10px]">Batas Kembali:</span>
        <strong class="text-white"><%= formatDate(borrowing.tglKembaliRencana) %></strong>
      </div>
    </div>

    <% if (terlambatHari > 0) { %>
      <div class="p-3 rounded-xl bg-rose-500/20 border border-rose-400/30 text-rose-200 text-xs flex items-center justify-between">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-triangle-exclamation text-rose-400"></i>
          <span>Pengembalian terlambat <strong><%= terlambatHari %> hari</strong> dari rencana!</span>
        </div>
        <span class="font-bold">Estimasi Denda: <%= formatRupiah(perkiraanDendaTelat) %></span>
      </div>
    <% } %>
  </div>

  <!-- Form Pemeriksaan Fisik & Denda -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
    <form action="/borrowings/<%= borrowing.id %>/return" method="POST" class="space-y-6">

      <!-- 1. Kondisi Fisik Alat -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Hasil Pemeriksaan Fisik Alat Saat Dikembalikan *
        </label>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <!-- Kondisi BAIK -->
          <label class="relative flex flex-col p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-emerald-50/50 hover:border-emerald-300 cursor-pointer transition-all has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50 has-[:checked]:ring-2 has-[:checked]:ring-emerald-500/20">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-800">BAIK / UTUH</span>
              <input type="radio" name="kondisiKembali" value="BAIK" checked onchange="setDendaPreset('BAIK')" class="text-emerald-600 focus:ring-emerald-500">
            </div>
            <p class="text-[11px] text-slate-500 mt-2">Kondisi fisik lengkap, fungsi alat normal, tanpa cacat.</p>
            <span class="text-[10px] font-bold text-emerald-700 mt-2">Denda: Rp 0</span>
          </label>

          <!-- Kondisi RUSAK -->
          <label class="relative flex flex-col p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-rose-50/50 hover:border-rose-300 cursor-pointer transition-all has-[:checked]:border-rose-500 has-[:checked]:bg-rose-50 has-[:checked]:ring-2 has-[:checked]:ring-rose-500/20">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-rose-800">RUSAK / PATAH</span>
              <input type="radio" name="kondisiKembali" value="RUSAK" onchange="setDendaPreset('RUSAK')" class="text-rose-600 focus:ring-rose-500">
            </div>
            <p class="text-[11px] text-slate-500 mt-2">Alat mengalami kerusakan komponen, kabel putus, patah, atau hang.</p>
            <span class="text-[10px] font-bold text-rose-700 mt-2">Dikenakan Denda</span>
          </label>

          <!-- Kondisi HILANG -->
          <label class="relative flex flex-col p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-100 hover:border-slate-400 cursor-pointer transition-all has-[:checked]:border-slate-700 has-[:checked]:bg-slate-100 has-[:checked]:ring-2 has-[:checked]:ring-slate-700/20">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900">HILANG</span>
              <input type="radio" name="kondisiKembali" value="HILANG" onchange="setDendaPreset('HILANG')" class="text-slate-900 focus:ring-slate-700">
            </div>
            <p class="text-[11px] text-slate-500 mt-2">Alat tidak dapat dikembalikan / hilang selama peminjaman.</p>
            <span class="text-[10px] font-bold text-slate-800 mt-2">Ganti Rugi Penuh</span>
          </label>
        </div>
      </div>

      <!-- 2. Nominal Denda (Rp) -->
      <div>
        <label for="denda" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Besaran Denda / Biaya Ganti Rugi (Rp) *
        </label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-bold text-xs">
            Rp
          </span>
          <input type="number" id="denda" name="denda" min="0" step="1000" value="0" required class="w-full pl-11 pr-4 py-2.5 text-sm font-bold bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
        </div>
        <p class="text-[11px] text-slate-400 mt-1">Masukkan nominal denda kerusakan/keterlambatan jika ada (Isi 0 jika kondisi baik).</p>
      </div>

      <!-- 3. Catatan Inspeksi Fisik Alat -->
      <div>
        <label for="catatanInspeksi" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Catatan Detail Pemeriksaan Fisik *
        </label>
        <textarea id="catatanInspeksi" name="catatanInspeksi" rows="3" required placeholder="Contoh: Alat diperiksa dalam kondisi baik dan lengkap, konektor RJ45 utuh..." class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">Pemeriksaan fisik oleh Toolman lab: Alat diterima dan dicek fungsi normal.</textarea>
      </div>

      <!-- 4. Update Kondisi Master Alat jika Rusak -->
      <div id="tool-status-option" class="hidden p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-900">
        <label class="flex items-center gap-2.5 cursor-pointer">
          <input type="checkbox" name="updateToolStatus" value="yes" class="rounded text-rose-600 focus:ring-rose-500">
          <span class="font-semibold">Tandai status master alat di inventaris sebagai "RUSAK" (Perlu Servis Lab)</span>
        </label>
      </div>

      <!-- Submit Action -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
        <a href="/borrowings" class="px-5 py-2.5 text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
          Batal
        </a>
        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md shadow-blue-500/20 transition-all flex items-center gap-2">
          <i class="fa-solid fa-clipboard-check"></i>
          <span>Simpan & Selesaikan Pengembalian</span>
        </button>
      </div>

    </form>
  </div>

</div>

<script>
  function setDendaPreset(kondisi) {
    const dendaInput = document.getElementById('denda');
    const notesInput = document.getElementById('catatanInspeksi');
    const statusOption = document.getElementById('tool-status-option');
    const overdueFine = <%= perkiraanDendaTelat %>;

    if (kondisi === 'BAIK') {
      dendaInput.value = overdueFine;
      notesInput.value = 'Pemeriksaan fisik: Alat diterima lengkap dan berfungsi normal tanpa cacat.';
      statusOption.classList.add('hidden');
    } else if (kondisi === 'RUSAK') {
      dendaInput.value = Math.max(50000, overdueFine + 50000); // Simulasi denda kerusakan standar
      notesInput.value = 'Pemeriksaan fisik: Ditemukan kerusakan fisik/komponen pada alat praktikum akibat penggunaan.';
      statusOption.classList.remove('hidden');
    } else if (kondisi === 'HILANG') {
      dendaInput.value = 150000;
      notesInput.value = 'Pemeriksaan fisik: Alat praktikum dinyatakan hilang oleh peminjam, dikenakan penggantian unit.';
      statusOption.classList.add('hidden');
    }
  }
</script>

<%- include('../partials/footer') %>
