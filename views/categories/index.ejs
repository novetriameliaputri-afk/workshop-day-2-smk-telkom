<%- include('../partials/header') %>

<div class="space-y-6">

  <!-- Header Section -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-bold text-slate-900">Kategori Alat Praktikum Lab</h1>
        <span class="px-2 py-0.5 text-xs font-bold rounded-full bg-blue-100 text-blue-700">Master Data</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Klasifikasi kategori alat (Jaringan, Elektronika, Proyektor, Perkakas Lab) untuk mempermudah sirkulasi</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Column 1: Form Tambah Kategori -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm h-fit">
      <h2 class="text-base font-bold text-slate-900 mb-1 flex items-center gap-2">
        <i class="fa-solid fa-folder-plus text-blue-600"></i>
        <span>Tambah Kategori Baru</span>
      </h2>
      <p class="text-xs text-slate-400 mb-4">Tambahkan klasifikasi kategori baru untuk peralatan lab praktikum</p>

      <form action="/categories" method="POST" class="space-y-4">
        <div>
          <label for="namaKategori" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Kategori *</label>
          <input type="text" id="namaKategori" name="namaKategori" required placeholder="Contoh: IoT & Robotika" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
        </div>

        <button type="submit" class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md shadow-blue-500/20 transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-plus"></i>
          <span>Simpan Kategori</span>
        </button>
      </form>
    </div>

    <!-- Column 2 & 3: Daftar Kategori -->
    <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="font-bold text-slate-800 text-base">Daftar Kategori Terdaftar</h2>
          <p class="text-xs text-slate-400 mt-0.5">Kelola dan perbarui nama kategori alat lab</p>
        </div>
        <span class="px-2.5 py-1 text-xs font-bold bg-slate-100 text-slate-700 rounded-full">
          <%= categories.length %> Kategori
        </span>
      </div>

      <div class="divide-y divide-slate-100">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/80 transition-colors">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-base flex-shrink-0 mt-0.5">
                  <i class="fa-solid fa-tag"></i>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm"><%= cat.namaKategori %></h3>
                  <p class="text-xs text-slate-500 mt-0.5">
                    Memuat <span class="font-bold text-blue-600"><%= cat._count.tools %> alat praktikum</span> terdaftar
                  </p>
                  
                  <% if (cat.tools && cat.tools.length > 0) { %>
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      <% cat.tools.slice(0, 3).forEach(t => { %>
                        <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md">
                          <%= t.namaAlat %> (<%= t.stok %>)
                        </span>
                      <% }) %>
                      <% if (cat.tools.length > 3) { %>
                        <span class="text-[10px] text-slate-400 self-center">+<%= cat.tools.length - 3 %> lainnya</span>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex items-center gap-2 self-end sm:self-center">
                <!-- Inline Edit Form (Prompt Modal) -->
                <button type="button" onclick="editCategory('<%= cat.id %>', '<%= cat.namaKategori %>')" class="px-3 py-1.5 text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors flex items-center gap-1">
                  <i class="fa-solid fa-pen text-[10px]"></i> Edit
                </button>

                <!-- Delete Category -->
                <form action="/categories/<%= cat.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus kategori <%= cat.namaKategori %>?')">
                  <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-lg transition-colors flex items-center gap-1" <%= cat._count.tools > 0 ? 'disabled title="Tidak bisa dihapus karena masih ada alat di dalamnya"' : '' %>>
                    <i class="fa-solid fa-trash text-[10px]"></i> Hapus
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="p-8 text-center text-slate-400">Belum ada kategori alat yang terdaftar.</div>
        <% } %>
      </div>
    </div>

  </div>

</div>

<!-- Hidden Edit Modal/Form via JS -->
<div id="edit-cat-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl border border-slate-200">
    <h3 class="text-base font-bold text-slate-900 mb-1">Edit Nama Kategori</h3>
    <p class="text-xs text-slate-400 mb-4">Ubah nama kategori alat praktikum</p>

    <form id="edit-cat-form" method="POST" class="space-y-4">
      <div>
        <label for="edit-namaKategori" class="block text-xs font-bold text-slate-700 uppercase mb-1">Nama Kategori</label>
        <input type="text" id="edit-namaKategori" name="namaKategori" required class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none">
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button type="button" onclick="closeEditCatModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl">Batal</button>
        <button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function editCategory(id, currentName) {
    const modal = document.getElementById('edit-cat-modal');
    const form = document.getElementById('edit-cat-form');
    const input = document.getElementById('edit-namaKategori');
    form.action = '/categories/' + id;
    input.value = currentName;
    modal.classList.remove('hidden');
  }

  function closeEditCatModal() {
    document.getElementById('edit-cat-modal').classList.add('hidden');
  }
</script>

<%- include('../partials/footer') %>
