<%- include('../partials/header') %>

<div class="space-y-6">

  <!-- Welcome Banner Toolman -->
  <div class="bg-gradient-to-r from-amber-600 via-orange-600 to-amber-700 rounded-3xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden">
    <div class="relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-white mb-3 border border-white/20">
        <i class="fa-solid fa-screwdriver-wrench"></i>
        <span>MEJA KERJA TOOLMAN & LABORAN</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Halo, <%= currentUser.nama %>!</h1>
      <p class="mt-2 text-amber-100 text-sm max-w-2xl">
        Verifikasi permohonan pinjam alat praktikum, lakukan inspeksi fisik kondisi pengembalian, kelola denda kerusakan, dan cetak laporan sirkulasi harian lab.
      </p>

      <div class="mt-5 flex flex-wrap gap-2.5">
        <a href="/reports" class="inline-flex items-center gap-2 px-4 py-2 bg-white text-amber-900 hover:bg-amber-50 rounded-xl text-xs font-bold shadow-md transition-colors">
          <i class="fa-solid fa-print"></i> Cetak Laporan Sirkulasi
        </a>
        <a href="/tools" class="inline-flex items-center gap-2 px-4 py-2 bg-amber-800/60 hover:bg-amber-800 text-white rounded-xl text-xs font-semibold transition-colors border border-amber-400/30">
          <i class="fa-solid fa-boxes-stacked"></i> Periksa Stok Alat Lab
        </a>
      </div>
    </div>
    
    <!-- Watermark Icon -->
    <i class="fa-solid fa-toolbox absolute -right-6 -bottom-8 text-white/10 text-9xl pointer-events-none"></i>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Stat 1: Pending Approvals -->
    <div class="bg-white border <%= stats.pendingCount > 0 ? 'border-amber-400 ring-2 ring-amber-400/20' : 'border-slate-200' %> rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Menunggu Persetujuan</span>
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-hourglass-half"></i>
        </div>
      </div>
      <p class="text-3xl font-extrabold <%= stats.pendingCount > 0 ? 'text-amber-600' : 'text-slate-900' %> mt-2"><%= stats.pendingCount %></p>
      <p class="text-xs text-slate-500 mt-2">Permohonan siswa butuh approval</p>
    </div>

    <!-- Stat 2: Active Borrowings -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Sedang Dipinjam</span>
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-hand-holding"></i>
        </div>
      </div>
      <p class="text-3xl font-extrabold text-blue-600 mt-2"><%= stats.activeCount %></p>
      <p class="text-xs text-slate-500 mt-2">Alat berada di tangan peminjam</p>
    </div>

    <!-- Stat 3: Damaged Items Recorded -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Alat Rusak / Denda</span>
        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
      </div>
      <p class="text-3xl font-extrabold text-rose-600 mt-2"><%= stats.damagedCount %></p>
      <p class="text-xs text-slate-500 mt-2">Kasus kerusakan tercatat</p>
    </div>

    <!-- Stat 4: Fine Total -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Denda Terkumpul</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-receipt"></i>
        </div>
      </div>
      <p class="text-2xl font-extrabold text-emerald-600 mt-2"><%= formatRupiah(stats.totalDenda) %></p>
      <p class="text-xs text-slate-500 mt-2">Kas lab dari denda/ganti rugi</p>
    </div>
  </div>

  <!-- ACTION QUEUE 1: Antrean Permohonan Pinjam (APPROVAL QUEUE) -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-amber-50/40">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center font-bold text-sm">
          <i class="fa-solid fa-clipboard-question"></i>
        </div>
        <div>
          <h2 class="font-bold text-slate-900 text-base">Antrean Permohonan Peminjaman (Approval)</h2>
          <p class="text-xs text-slate-500">Persetujuan peminjaman alat praktikum oleh siswa/guru</p>
        </div>
      </div>
      <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-amber-100 text-amber-900">
        <%= pendingApprovals.length %> Butuh Tindakan
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 font-semibold uppercase tracking-wider">
            <th class="py-3 px-4">Peminjam</th>
            <th class="py-3 px-4">Alat & Spesifikasi</th>
            <th class="py-3 px-4">Jumlah</th>
            <th class="py-3 px-4">Stok Saat Ini</th>
            <th class="py-3 px-4">Rencana Kembali</th>
            <th class="py-3 px-4">Keperluan Praktikum</th>
            <th class="py-3 px-4 text-center">Aksi Toolman</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (pendingApprovals && pendingApprovals.length > 0) { %>
            <% pendingApprovals.forEach(item => { %>
              <tr class="hover:bg-amber-50/30 transition-colors">
                <td class="py-3 px-4">
                  <p class="font-bold text-slate-900"><%= item.user.nama %></p>
                  <p class="text-[11px] text-slate-500"><%= item.user.nisn ? 'NISN: ' + item.user.nisn : item.user.telepon %></p>
                </td>
                <td class="py-3 px-4">
                  <p class="font-bold text-slate-800"><%= item.tool.namaAlat %></p>
                  <p class="text-[11px] text-slate-400 truncate max-w-xs"><%= item.tool.spesifikasi || '-' %></p>
                </td>
                <td class="py-3 px-4">
                  <span class="font-extrabold text-blue-700 bg-blue-50 px-2 py-0.5 rounded"><%= item.jumlah %> Unit</span>
                </td>
                <td class="py-3 px-4">
                  <% if (item.tool.stok >= item.jumlah) { %>
                    <span class="font-bold text-emerald-600"><%= item.tool.stok %> Unit (Cukup)</span>
                  <% } else { %>
                    <span class="font-bold text-rose-600"><%= item.tool.stok %> Unit (Kurang!)</span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-slate-600"><%= formatDate(item.tglKembaliRencana) %></td>
                <td class="py-3 px-4 text-slate-600 italic">"<%= item.catatan || 'Praktikum' %>"</td>
                <td class="py-3 px-4">
                  <div class="flex items-center justify-center gap-2">
                    <!-- Tombol Approve -->
                    <form action="/borrowings/<%= item.id %>/approve" method="POST" onsubmit="return confirm('Apakah Anda yakin menyetujui peminjaman <%= item.jumlah %> unit <%= item.tool.namaAlat %> untuk <%= item.user.nama %>? Stok akan langsung dikurangi.')">
                      <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors">
                        <i class="fa-solid fa-check"></i> Setujui
                      </button>
                    </form>

                    <!-- Tombol Tolak -->
                    <form action="/borrowings/<%= item.id %>/reject" method="POST" onsubmit="return confirm('Tolak permohonan peminjaman ini?')">
                      <input type="hidden" name="alasan" value="Alat sedang dipakai praktikum lain / stok tidak mencukupi">
                      <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg text-xs font-semibold transition-colors">
                        <i class="fa-solid fa-xmark"></i> Tolak
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-8 text-center text-slate-400">
                <i class="fa-solid fa-circle-check text-2xl text-emerald-400 mb-1 block"></i>
                Tidak ada permohonan pinjam yang menunggu persetujuan. Meja kerja bersih!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ACTION QUEUE 2: Alat Sedang Dipinjam Siswa (RETURN & INSPECTION QUEUE) -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm">
          <i class="fa-solid fa-arrows-spin"></i>
        </div>
        <div>
          <h2 class="font-bold text-slate-900 text-base">Alat Praktikum Sedang Dipinjam (Pantau & Pengembalian)</h2>
          <p class="text-xs text-slate-500">Periksa kondisi fisik dan catat denda jika ada kerusakan saat alat kembali</p>
        </div>
      </div>
      <a href="/borrowings?status=APPROVED" class="text-xs font-semibold text-blue-600 hover:underline">
        Lihat Semua (<%= activeBorrowings.length %>)
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 font-semibold uppercase tracking-wider">
            <th class="py-3 px-4">Peminjam</th>
            <th class="py-3 px-4">Alat Praktikum</th>
            <th class="py-3 px-4">Jumlah</th>
            <th class="py-3 px-4">Tgl Pinjam</th>
            <th class="py-3 px-4">Batas Kembali</th>
            <th class="py-3 px-4">Keterangan</th>
            <th class="py-3 px-4 text-center">Tindakan Toolman</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (activeBorrowings && activeBorrowings.length > 0) { %>
            <% activeBorrowings.forEach(item => { %>
              <% const isOverdue = new Date() > new Date(item.tglKembaliRencana); %>
              <tr class="hover:bg-slate-50 transition-colors <%= isOverdue ? 'bg-rose-50/30' : '' %>">
                <td class="py-3 px-4">
                  <p class="font-bold text-slate-900"><%= item.user.nama %></p>
                  <p class="text-[11px] text-slate-500"><%= item.user.nisn ? 'NISN: ' + item.user.nisn : item.user.telepon %></p>
                </td>
                <td class="py-3 px-4">
                  <p class="font-semibold text-slate-800"><%= item.tool.namaAlat %></p>
                  <span class="text-[10px] text-slate-400"><%= item.tool.category.namaKategori %></span>
                </td>
                <td class="py-3 px-4 font-bold text-slate-700"><%= item.jumlah %> Unit</td>
                <td class="py-3 px-4 text-slate-600"><%= formatDate(item.tglPinjam) %></td>
                <td class="py-3 px-4">
                  <% if (isOverdue) { %>
                    <span class="inline-flex items-center gap-1 font-bold text-rose-600">
                      <i class="fa-solid fa-clock-rotate-left"></i> <%= formatDate(item.tglKembaliRencana) %> (Lewat Batas!)
                    </span>
                  <% } else { %>
                    <span class="text-slate-600"><%= formatDate(item.tglKembaliRencana) %></span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-slate-500 truncate max-w-xs"><%= item.catatan || '-' %></td>
                <td class="py-3 px-4 text-center">
                  <!-- Tombol Inspeksi Pengembalian & Denda -->
                  <a href="/borrowings/<%= item.id %>/return" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors">
                    <i class="fa-solid fa-clipboard-check"></i>
                    <span>Cek Fisik & Pengembalian</span>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-8 text-center text-slate-400">
                Saat ini tidak ada alat praktikum yang sedang dipinjam siswa.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SECTION 3: Riwayat Pengembalian Terakhir Diperiksa -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="font-bold text-slate-900 text-base">Riwayat Pemeriksaan Pengembalian Terakhir</h2>
        <p class="text-xs text-slate-500">Catatan kondisi fisik alat saat diterima kembali di meja toolman</p>
      </div>
      <a href="/reports" class="text-xs font-semibold text-blue-600 hover:underline">
        Cetak Laporan Lengkap <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 font-semibold uppercase tracking-wider">
            <th class="py-3 px-4">Peminjam</th>
            <th class="py-3 px-4">Alat</th>
            <th class="py-3 px-4">Tgl Kembali Riil</th>
            <th class="py-3 px-4">Kondisi Fisik</th>
            <th class="py-3 px-4">Denda (Rp)</th>
            <th class="py-3 px-4">Catatan Kondisi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (recentReturns && recentReturns.length > 0) { %>
            <% recentReturns.forEach(item => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-3 px-4 font-semibold text-slate-800"><%= item.user.nama %></td>
                <td class="py-3 px-4 text-slate-800"><%= item.tool.namaAlat %></td>
                <td class="py-3 px-4 text-slate-600"><%= formatDateTime(item.tglKembaliReal) %></td>
                <td class="py-3 px-4">
                  <% if (item.kondisiKembali === 'BAIK') { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800">
                      <i class="fa-solid fa-check text-[10px]"></i> BAIK
                    </span>
                  <% } else if (item.kondisiKembali === 'RUSAK') { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-800">
                      <i class="fa-solid fa-triangle-exclamation text-[10px]"></i> RUSAK
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-200 text-slate-800">
                      HILANG
                    </span>
                  <% } %>
                </td>
                <td class="py-3 px-4 font-bold <%= item.denda > 0 ? 'text-rose-600' : 'text-slate-400' %>">
                  <%= item.denda > 0 ? formatRupiah(item.denda) : 'Rp 0' %>
                </td>
                <td class="py-3 px-4 text-slate-600 max-w-sm"><%= item.catatan || '-' %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="py-6 text-center text-slate-400">Belum ada catatan pengembalian.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
