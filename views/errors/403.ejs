<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '403 - Akses Ditolak' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full flex items-center justify-center p-4 font-sans text-slate-800">

  <div class="max-w-md w-full bg-white border border-slate-200 rounded-3xl p-8 text-center shadow-xl shadow-slate-200/50">
    <div class="w-16 h-16 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto text-3xl mb-4 border border-rose-100">
      <i class="fa-solid fa-lock"></i>
    </div>

    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">403 - Akses Ditolak</h1>
    <p class="text-xs text-rose-600 font-bold uppercase tracking-wider mt-1">Hak Akses Tidak Mencukupi (Forbidden)</p>

    <div class="my-5 p-4 rounded-2xl bg-slate-50 border border-slate-200 text-left text-xs space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-slate-500">Role Anda Saat Ini:</span>
        <span class="font-bold text-slate-900 px-2 py-0.5 rounded bg-slate-200"><%= typeof userRole !== 'undefined' ? userRole : 'GUEST' %></span>
      </div>
      <% if (typeof requiredRoles !== 'undefined' && requiredRoles.length > 0) { %>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Role yang Diizinkan:</span>
          <span class="font-bold text-blue-700"><%= requiredRoles.join(', ') %></span>
        </div>
      <% } %>
      <p class="text-[11px] text-slate-400 pt-1 border-t border-slate-200">
        Anda tidak memiliki izin Role-Based Access Control (RBAC) untuk membuka halaman ini.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-2.5">
      <a href="/" class="flex-1 py-2.5 px-4 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-xl transition-colors">
        <i class="fa-solid fa-house mr-1"></i> Dashboard Utama
      </a>
      <a href="/auth/logout" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-colors">
        Ganti Akun
      </a>
    </div>
  </div>

</body>
</html>
