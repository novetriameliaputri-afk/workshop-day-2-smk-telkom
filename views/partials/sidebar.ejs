<!-- Sidebar Navigation (Responsive with Mobile Drawer) -->
<aside id="sidebar-nav" class="w-full md:w-64 flex-shrink-0 hidden md:block no-print">
  <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm sticky top-24">
    
    <!-- User Quick Badge -->
    <div class="p-3 mb-4 rounded-xl bg-gradient-to-r <%= currentUser.role === 'ADMIN' ? 'from-purple-50 to-indigo-50 border border-purple-100' : (currentUser.role === 'TOOLMAN' ? 'from-amber-50 to-orange-50 border border-amber-100' : 'from-emerald-50 to-teal-50 border border-emerald-100') %>">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center font-bold text-white shadow-sm <%= currentUser.role === 'ADMIN' ? 'bg-purple-600' : (currentUser.role === 'TOOLMAN' ? 'bg-amber-600' : 'bg-emerald-600') %>">
          <i class="<%= currentUser.role === 'ADMIN' ? 'fa-solid fa-user-shield' : (currentUser.role === 'TOOLMAN' ? 'fa-solid fa-screwdriver-wrench' : 'fa-solid fa-graduation-cap') %>"></i>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold text-slate-800 truncate"><%= currentUser.nama %></p>
          <span class="inline-block mt-0.5 px-2 py-0.5 text-[10px] font-bold rounded-full <%= currentUser.role === 'ADMIN' ? 'bg-purple-200/60 text-purple-800' : (currentUser.role === 'TOOLMAN' ? 'bg-amber-200/60 text-amber-800' : 'bg-emerald-200/60 text-emerald-800') %>">
            ROLE: <%= currentUser.role %>
          </span>
        </div>
      </div>
    </div>

    <!-- Navigation Menu Items -->
    <nav class="space-y-1">
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Menu Navigasi</p>

      <!-- 1. DASHBOARD (ALL ROLES) -->
      <a href="/" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
        <i class="fa-solid fa-chart-pie w-5 text-center <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'text-white' : 'text-slate-400' %>"></i>
        <span>Dashboard</span>
      </a>

      <!-- 2. ADMIN ONLY MENUS -->
      <% if (currentUser.role === 'ADMIN') { %>
        <a href="/users" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-users-gear w-5 text-center <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'text-white' : 'text-slate-400' %>"></i>
          <span>Data Pengguna (User)</span>
        </a>

        <a href="/tools" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'tools' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-toolbox w-5 text-center <%= typeof currentPage !== 'undefined' && currentPage === 'tools' ? 'text-white' : 'text-slate-400' %>"></i>
          <span>Inventaris Alat Lab</span>
        </a>

        <a href="/categories" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'categories' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-tags w-5 text-center <%= typeof currentPage !== 'undefined' && currentPage === 'categories' ? 'text-white' : 'text-slate-400' %>"></i>
          <span>Kategori Alat</span>
        </a>

        <a href="/borrowings" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'borrowings' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-arrows-rotate w-5 text-center <%= typeof currentPage !== 'undefined' && currentPage === 'borrowings' ? 'text-white' : 'text-slate-400' %>"></i>
          <span>Master Transaksi</span>
        </a>

        <a href="/reports" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'reports' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-file-invoice w-5 text-center <%= typeof currentPage !== 'undefined' && currentPage === 'reports' ? 'text-white' : 'text-slate-400' %>"></i>
          <span>Laporan Sirkulasi</span>
        </a>

        <a href="/activity-logs" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'activity-logs' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-clock-rotate-left w-5 text-center <%= typeof currentPage !== 'undefined' && currentPage === 'activity-logs' ? 'text-white' : 'text-slate-400' %>"></i>
          <span>Log Aktifitas Lab</span>
        </a>
      <% } %>

      <!-- 3. TOOLMAN ONLY MENUS -->
      <% if (currentUser.role === 'TOOLMAN') { %>
        <a href="/borrowings?status=PENDING" class="flex items-center justify-between px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'borrowings' && typeof filters !== 'undefined' && filters.status === 'PENDING' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-clipboard-check w-5 text-center text-amber-500"></i>
            <span>Verifikasi Pinjaman</span>
          </div>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Review</span>
        </a>

        <a href="/borrowings?status=APPROVED" class="flex items-center justify-between px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'borrowings' && typeof filters !== 'undefined' && filters.status === 'APPROVED' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-rotate-left w-5 text-center text-blue-500"></i>
            <span>Pantau Pengembalian</span>
          </div>
        </a>

        <a href="/borrowings" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'borrowings' && (typeof filters === 'undefined' || !filters.status) ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-list-check w-5 text-center text-slate-400"></i>
          <span>Semua Sirkulasi</span>
        </a>

        <a href="/tools" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'tools' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-boxes-stacked w-5 text-center text-slate-400"></i>
          <span>Cek Stok Alat Lab</span>
        </a>

        <a href="/reports" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'reports' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-print w-5 text-center text-slate-400"></i>
          <span>Cetak Laporan</span>
        </a>
      <% } %>

      <!-- 4. PEMINJAM (SISWA / GURU) MENUS -->
      <% if (currentUser.role === 'PEMINJAM') { %>
        <a href="/tools" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'tools' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-magnifying-glass-chart w-5 text-center text-slate-400"></i>
          <span>Katalog & Stok Alat</span>
        </a>

        <a href="/borrowings/new" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'borrowings' && typeof isNew !== 'undefined' ? 'bg-blue-600 text-white shadow-sm' : 'text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200' %>">
          <i class="fa-solid fa-plus-circle w-5 text-center text-emerald-600"></i>
          <span class="font-semibold">Ajukan Pinjam Alat</span>
        </a>

        <a href="/borrowings" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'borrowings' && typeof isNew === 'undefined' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
          <i class="fa-solid fa-clock-rotate-left w-5 text-center text-slate-400"></i>
          <span>Pinjaman Saya</span>
        </a>
      <% } %>

    </nav>

    <!-- Lab Info Box -->
    <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] text-slate-400 space-y-1">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-slate-600">Sistem Online & Siap</span>
      </div>
      <p>Lab RPL & Elektronika • UKK</p>
    </div>

  </div>
</aside>
