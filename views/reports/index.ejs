<%- include('../partials/header') %>

<div class="space-y-6">

  <!-- Print-Only Header: Kop Surat Resmi Sekolah -->
  <div class="print-only mb-6 border-b-2 border-slate-900 pb-4 text-center">
    <div class="flex items-center justify-between border-b border-slate-300 pb-3 mb-2">
      <div class="w-16 h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-2xl">
        <i class="fa-solid fa-microchip"></i>
      </div>
      <div class="flex-1 text-center px-4">
        <h2 class="text-base font-bold tracking-wider text-slate-800 uppercase">YAYASAN PENDIDIKAN TELKOM</h2>
        <h1 class="text-xl font-extrabold tracking-tight text-slate-900 uppercase">SMK TELKOM LAMPUNG</h1>
        <p class="text-xs text-slate-600">LABORATORIUM REKAYASA PERANGKAT LUNAK & ELEKTRONIKA</p>
        <p class="text-[10px] text-slate-500">Jl. Purnawirawan No. 1, Gedong Meneng • Email: lab.rpl@smktelkom-lpg.sch.id</p>
      </div>
      <div class="w-16 h-16 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-bold text-xs border border-slate-300">
        UKK 2026
      </div>
    </div>
    <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900 mt-2">
      LAPORAN SIRKULASI PEMINJAMAN & PENGEMBALIAN SARPRAS LAB
    </h3>
    <p class="text-[11px] text-slate-500">
      Periode Cetak: <%= filters.startDate ? formatDate(filters.startDate) : 'Awal' %> s/d <%= filters.endDate ? formatDate(filters.endDate) : 'Sekarang' %> • Dicetak pada: <%= formatDateTime(new Date()) %>
    </p>
  </div>

  <!-- Screen-Only Header Section with Actions -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 no-print">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-bold text-slate-900">Laporan Sirkulasi Peralatan Praktikum</h1>
        <span class="px-2 py-0.5 text-xs font-bold rounded-full bg-blue-100 text-blue-700">Official Report</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Rekapitulasi sirkulasi alat, verifikasi pengembalian fisik, dan penerimaan denda lab</p>
    </div>

    <!-- Print Button -->
    <div class="flex items-center gap-2">
      <button type="button" onclick="window.print()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-md shadow-blue-500/20 transition-all">
        <i class="fa-solid fa-print"></i>
        <span>Cetak Laporan Resmi (PDF/Print)</span>
      </button>
    </div>
  </div>

  <!-- Screen-Only Filter Box -->
  <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm no-print">
    <form action="/reports" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <!-- Start Date -->
      <div>
        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Dari Tanggal</label>
        <input type="date" name="startDate" value="<%= filters.startDate %>" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500">
      </div>

      <!-- End Date -->
      <div>
        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Sampai Tanggal</label>
        <input type="date" name="endDate" value="<%= filters.endDate %>" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500">
      </div>

      <!-- Status Filter -->
      <div>
        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Status Transaksi</label>
        <select name="status" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500">
          <option value="ALL">Semua Status</option>
          <option value="APPROVED" <%= filters.status === 'APPROVED' ? 'selected' : '' %>>Sedang Dipinjam</option>
          <option value="RETURNED" <%= filters.status === 'RETURNED' ? 'selected' : '' %>>Selesai Dikembalikan</option>
          <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Menunggu Persetujuan</option>
          <option value="REJECTED" <%= filters.status === 'REJECTED' ? 'selected' : '' %>>Ditolak</option>
        </select>
      </div>

      <!-- Category Filter -->
      <div>
        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Kategori Alat</label>
        <select name="categoryId" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500">
          <option value="ALL">Semua Kategori</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= filters.categoryId == cat.id ? 'selected' : '' %>><%= cat.namaKategori %></option>
          <% }) %>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-end gap-2">
        <button type="submit" class="flex-1 py-2 px-3 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-semibold transition-colors">
          Filter Data
        </button>
        <a href="/reports" class="py-2 px-3 text-xs text-slate-500 hover:text-slate-800 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors">
          Reset
        </a>
      </div>
    </form>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
      <span class="text-[10px] font-bold uppercase text-slate-400">Total Transaksi</span>
      <p class="text-2xl font-extrabold text-slate-900 mt-1"><%= stats.totalTransactions %></p>
      <span class="text-xs text-slate-500"><%= stats.totalItemsBorrowed %> unit dipinjam</span>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
      <span class="text-[10px] font-bold uppercase text-slate-400">Telah Dikembalikan</span>
      <p class="text-2xl font-extrabold text-emerald-600 mt-1"><%= stats.countReturned %></p>
      <span class="text-xs text-emerald-700 font-medium"><%= stats.countGood %> kondisi baik</span>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
      <span class="text-[10px] font-bold uppercase text-slate-400">Alat Rusak Tercatat</span>
      <p class="text-2xl font-extrabold text-rose-600 mt-1"><%= stats.countDamaged %></p>
      <span class="text-xs text-rose-600 font-medium">Butuh perbaikan/servis</span>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
      <span class="text-[10px] font-bold uppercase text-slate-400">Penerimaan Denda</span>
      <p class="text-xl font-extrabold text-emerald-600 mt-1"><%= formatRupiah(stats.totalFine) %></p>
      <span class="text-xs text-slate-500">Kas denda kerusakan lab</span>
    </div>
  </div>

  <!-- Circulation Table -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-100 border-b border-slate-200 text-slate-700 font-bold uppercase tracking-wider">
            <th class="py-2.5 px-3">No</th>
            <th class="py-2.5 px-3">Tgl Pinjam</th>
            <th class="py-2.5 px-3">Peminjam</th>
            <th class="py-2.5 px-3">Alat Praktikum</th>
            <th class="py-2.5 px-3">Qty</th>
            <th class="py-2.5 px-3">Rencana Kembali</th>
            <th class="py-2.5 px-3">Kembali Riil</th>
            <th class="py-2.5 px-3">Status</th>
            <th class="py-2.5 px-3">Kondisi Fisik</th>
            <th class="py-2.5 px-3">Denda (Rp)</th>
            <th class="py-2.5 px-3">Toolman</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if (borrowings && borrowings.length > 0) { %>
            <% borrowings.forEach((b, index) => { %>
              <tr class="hover:bg-slate-50">
                <td class="py-2.5 px-3 font-semibold text-slate-500"><%= index + 1 %></td>
                <td class="py-2.5 px-3 text-slate-700"><%= formatDate(b.tglPinjam) %></td>
                <td class="py-2.5 px-3">
                  <p class="font-bold text-slate-900"><%= b.user.nama %></p>
                  <p class="text-[10px] text-slate-400 font-mono"><%= b.user.nisn ? b.user.nisn : b.user.role %></p>
                </td>
                <td class="py-2.5 px-3">
                  <p class="font-semibold text-slate-800"><%= b.tool.namaAlat %></p>
                  <span class="text-[10px] text-slate-400"><%= b.tool.category.namaKategori %></span>
                </td>
                <td class="py-2.5 px-3 font-bold text-slate-800"><%= b.jumlah %></td>
                <td class="py-2.5 px-3 text-slate-600"><%= formatDate(b.tglKembaliRencana) %></td>
                <td class="py-2.5 px-3 text-slate-600"><%= b.tglKembaliReal ? formatDate(b.tglKembaliReal) : '-' %></td>
                <td class="py-2.5 px-3">
                  <% if (b.status === 'APPROVED') { %>
                    <span class="font-bold text-blue-700">DIPINJAM</span>
                  <% } else if (b.status === 'RETURNED') { %>
                    <span class="font-bold text-emerald-700">KEMBALI</span>
                  <% } else if (b.status === 'PENDING') { %>
                    <span class="font-bold text-amber-700">PENDING</span>
                  <% } else { %>
                    <span class="font-bold text-rose-700">DITOLAK</span>
                  <% } %>
                </td>
                <td class="py-2.5 px-3">
                  <% if (b.kondisiKembali === 'BAIK') { %>
                    <span class="text-emerald-700 font-bold">BAIK</span>
                  <% } else if (b.kondisiKembali === 'RUSAK') { %>
                    <span class="text-rose-700 font-bold">RUSAK</span>
                  <% } else if (b.kondisiKembali === 'HILANG') { %>
                    <span class="text-slate-800 font-bold">HILANG</span>
                  <% } else { %>
                    <span class="text-slate-400">-</span>
                  <% } %>
                </td>
                <td class="py-2.5 px-3 font-bold <%= b.denda > 0 ? 'text-rose-600' : 'text-slate-500' %>">
                  <%= b.denda > 0 ? formatRupiah(b.denda) : '0' %>
                </td>
                <td class="py-2.5 px-3 text-slate-600">
                  <%= b.toolman ? b.toolman.nama.split(' ')[0] : '-' %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="11" class="py-8 text-center text-slate-400">Tidak ada data sirkulasi untuk filter yang dipilih.</td>
            </tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr class="bg-slate-100 font-bold text-slate-800">
            <td colspan="4" class="py-2.5 px-3 text-right">TOTAL KESELURUHAN:</td>
            <td class="py-2.5 px-3"><%= stats.totalItemsBorrowed %> Unit</td>
            <td colspan="4" class="py-2.5 px-3 text-right">TOTAL DENDA TERKUMPUL:</td>
            <td class="py-2.5 px-3 text-emerald-700"><%= formatRupiah(stats.totalFine) %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Print-Only Signature Block -->
  <div class="print-only mt-10 pt-6">
    <div class="flex items-center justify-between text-xs text-slate-800 px-6">
      
      <!-- Signature Toolman -->
      <div class="text-center w-64">
        <p>Bandar Lampung, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <p class="font-semibold mt-1">Toolman & Laboran Lab,</p>
        <div class="h-20"></div>
        <p class="font-bold underline text-slate-900">Rian Hidayat</p>
        <p class="text-[10px] text-slate-500">NIP/NUPTK. 199208152018021003</p>
      </div>

      <!-- Signature Kepala Lab -->
      <div class="text-center w-64">
        <p>&nbsp;</p>
        <p class="font-semibold mt-1">Mengetahui, Kepala Lab Komputer,</p>
        <div class="h-20"></div>
        <p class="font-bold underline text-slate-900">Bambang Sugiarto, S.Kom</p>
        <p class="text-[10px] text-slate-500">NIP. 198405122010011005</p>
      </div>

    </div>
  </div>

</div>

<%- include('../partials/footer') %>
