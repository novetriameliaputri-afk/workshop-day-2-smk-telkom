<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto space-y-6">

  <!-- Header -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-slate-900"><%= isEdit ? 'Edit Data Pengguna' : 'Tambah Pengguna Baru' %></h1>
      <p class="text-xs text-slate-500 mt-1"><%= isEdit ? 'Perbarui informasi akun dan hak akses pengguna' : 'Daftarkan akun Admin, Toolman, atau Siswa/Guru baru' %></p>
    </div>
    <a href="/users" class="px-3.5 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
      <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
    </a>
  </div>

  <!-- Form Card -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
    <form action="<%= isEdit ? '/users/' + user.id : '/users' %>" method="POST" class="space-y-5">
      
      <!-- Nama Lengkap -->
      <div>
        <label for="nama" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Lengkap *</label>
        <input type="text" id="nama" name="nama" value="<%= user ? user.nama : '' %>" required placeholder="Contoh: Ahmad Rizki Maulana" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Username -->
        <div>
          <label for="username" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Username Login *</label>
          <input type="text" id="username" name="username" value="<%= user ? user.username : '' %>" required placeholder="Contoh: ahmad_rpl" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
        </div>

        <!-- Role Level -->
        <div>
          <label for="role" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Role Hak Akses (RBAC) *</label>
          <select id="role" name="role" required class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
            <option value="PEMINJAM" <%= user && user.role === 'PEMINJAM' ? 'selected' : '' %>>PEMINJAM (Siswa / Guru)</option>
            <option value="TOOLMAN" <%= user && user.role === 'TOOLMAN' ? 'selected' : '' %>>TOOLMAN (Laboran Lab)</option>
            <option value="ADMIN" <%= user && user.role === 'ADMIN' ? 'selected' : '' %>>ADMIN (Kepala Lab / IT)</option>
          </select>
        </div>
      </div>

      <!-- Password -->
      <div>
        <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Kata Sandi (Password) <%= isEdit ? '(Kosongkan jika tidak ingin mengubah kata sandi)' : '*' %>
        </label>
        <input type="password" id="password" name="password" <%= isEdit ? '' : 'required' %> placeholder="<%= isEdit ? '••••••••' : 'Minimal 6 karakter' %>" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- NISN / Identitas -->
        <div>
          <label for="nisn" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">NISN / NIP / No. Identitas</label>
          <input type="text" id="nisn" name="nisn" value="<%= user && user.nisn ? user.nisn : '' %>" placeholder="Contoh: 0071234567" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
        </div>

        <!-- Telepon -->
        <div>
          <label for="telepon" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nomor Telepon / WhatsApp</label>
          <input type="text" id="telepon" name="telepon" value="<%= user && user.telepon ? user.telepon : '' %>" placeholder="Contoh: 08123456789" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
        <a href="/users" class="px-5 py-2.5 text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
          Batal
        </a>
        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md shadow-blue-500/20 transition-all flex items-center gap-2">
          <i class="fa-solid fa-floppy-disk"></i>
          <span><%= isEdit ? 'Simpan Perubahan' : 'Daftarkan Pengguna' %></span>
        </button>
      </div>

    </form>
  </div>

</div>

<%- include('../partials/footer') %>
